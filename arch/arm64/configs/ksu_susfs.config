# SukiSU Ultra + SUSFS config fragment for pacman (v2 â€” stealth fixes 2026-06-18)
CONFIG_KSU=y
CONFIG_KPM=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_TMPFS_XATTR=y
CONFIG_KPROBES=y
# Stealth: block /proc/config.gz exposing CONFIG_KSU*
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# Stealth: block unprivileged dmesg (KernelSU log lines)
CONFIG_SECURITY_DMESG_RESTRICT=y
# Stealth: hardcode stock LOCALVERSION, disable git auto-version
CONFIG_LOCALVERSION_AUTO=n
CONFIG_LOCALVERSION="-android13-8-00004-g1c3825f8ac0a-ab14110541"
